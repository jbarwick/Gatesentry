# AI keys and models. Copy to .env and fill in.
# Used by:
#   - live image-analyzer tests (go test ./application/filters -run TestLive)
#   - docker compose (interpolated into the container; seeds empty /gatesentry/ai settings)
# The admin UI can change seeded values; non-empty stored settings are not overwritten.
#
# Empty or CHANGE_ME values are ignored. Do not commit .env.

GS_AI_GROK_API_KEY=CHANGE_ME
GS_AI_GROK_MODEL=grok-4.5

GS_AI_OPENAI_API_KEY=CHANGE_ME
GS_AI_OPENAI_MODEL=gpt-4o-mini

GS_AI_OLLAMA_URL=http://127.0.0.1:11434
GS_AI_OLLAMA_MODEL=llava

GS_AI_TEST_IMAGE=/home/jbarwick/Development/33091992_018_4cb3.jpg
